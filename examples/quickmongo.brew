# QuickMongo helper written in Brew

import { Database } from 'quickmongo'

fn connectDB(url: String) -> Object
  db = new Database(url)
  db.connect()
  db


fn setTyped(db: Object, key: String, value: Object) -> Object
  db.set(key, value)


fn getTyped(db: Object, key: String) -> Object
  db.get(key)


fn deleteKey(db: Object, key: String) -> Boolean
  db.delete(key)


export class QuickMongoHelper
  db: Object
  url: String

  fn constructor(url: String)
    @url = url
    @db = null

  fn connect() -> Object
    @db = connectDB(@url)
    @db

  fn set(key: String, value: Object) -> Object
    setTyped(@db, key, value)

  fn get(key: String) -> Object
    getTyped(@db, key)

  fn delete(key: String) -> Boolean
    deleteKey(@db, key)
